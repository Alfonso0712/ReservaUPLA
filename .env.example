# =============================================================================
# ReservaUPLA · Plantilla de Variables de Entorno para Docker Compose
# Copie este archivo a .env y reemplace <CONTRASENA_AQUI> con claves locales:
#   cp .env.example .env
# El archivo .env está excluido en .gitignore y nunca debe subirse a Git.
# =============================================================================

# Base de datos PostgreSQL (administración e inicialización del esquema)
POSTGRES_DB=ReservasUPLA_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CONTRASENA_AQUI>

# Rol de aplicación de mínimo privilegio (usado por la API en ejecución)
DB_APP_USER=reservas_app
DB_APP_PASSWORD=<CONTRASENA_AQUI>

# Configuración del Frontend (puerto 5173 coincide con la política CORS del backend)
VITE_USAR_MOCK=false
VITE_API_URL=http://localhost:5000
